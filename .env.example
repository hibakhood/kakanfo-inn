# Kakanfo Inn & Conference Centre — environment variables
# Copy to .env.local (client) / Vercel project settings (serverless functions).

# --- Supabase (client + serverless) ---
# Create a project at https://supabase.com, run supabase/schema.sql + supabase/seed.sql,
# then paste the project URL and anon key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Resend (serverless email) ---
# Used by /api/send-booking-emails and /api/contact. Get a key at https://resend.com.
# NOTE: RESEND_API_KEY is server-side only — never expose it in the browser bundle.
RESEND_API_KEY=

# Optional: override the sender shown on booking/contact emails.
# RESEND_FROM_EMAIL=bookings@kakanfoinn.com

# --- Admin email (serverless only) ---
# Used by /api/contact and /api/send-booking-emails for admin notifications.
ADMIN_EMAIL=
